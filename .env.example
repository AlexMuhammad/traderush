# ---- BULLRUN ----------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
#
# SWITCHING NETWORK IS THIS ONE LINE. Chain id, RPC, indexer, collateral,
# decimals, tick/lot and venue all follow from it (packages/sdk/src/networks.ts).
#
#   testnet -> chain 50312, tUSDC, 6 decimals, has a faucet
#   mainnet -> chain 5031,  USDso, 18 decimals, real money
NETWORK=testnet

# The web app reads VITE_-prefixed names. Keep the two in step.
VITE_NETWORK=testnet

# ---- Escrow, per network ----------------------------------------------------
# Each network needs its own deploy. Both can live here at once; the active
# NETWORK picks which one is used, so switching never points at the wrong one.
DUEL_ESCROW_ADDRESS_TESTNET=
DUEL_ESCROW_ADDRESS_MAINNET=
# Vite only exposes VITE_-prefixed vars to the browser. Keep these in step with
# the two above, or the app reports "not deployed" against a live escrow.
VITE_DUEL_ESCROW_ADDRESS_TESTNET=
VITE_DUEL_ESCROW_ADDRESS_MAINNET=

# Rooms: many players, either side, any size. Same per-network rule.
ROOM_ESCROW_ADDRESS_TESTNET=
ROOM_ESCROW_ADDRESS_MAINNET=
VITE_ROOM_ESCROW_ADDRESS_TESTNET=
VITE_ROOM_ESCROW_ADDRESS_MAINNET=

# ---- Signers (packages/scripts only) ----------------------------------------
# Two DIFFERENT wallets — accept() reverts SelfDuel if they match.
# On mainnet these hold real funds. Treat accordingly.
PRIVATE_KEY_A=
PRIVATE_KEY_B=

# The wallet `pnpm maker` quotes from. Defaults to PRIVATE_KEY_B and must never
# be the wallet you play on: a maker rests orders and GETS FILLED, so its trades
# land in that account's Positions and History and read as the account betting
# by itself. Set this only to move the maker off B onto a wallet of its own.
# MAKER_PRIVATE_KEY=

# ---- Optional overrides -----------------------------------------------------
# Everything below defaults from the deployment map. Set one only when a
# redeploy lands before networks.ts is updated.

# RPC_URL=
# WS_RPC_URL=
# INDEXER_URL=
# REST_URL=
# EXPLORER_URL=
# CHAIN_ID=
# DECIMALS=

# Venue scope. THESE MOVE — both networks changed venue three times in the first
# week of August 2026. If reads return no markets, take venueId off a live row.
# VENUE_ID=

# Individual contract overrides.
# COLLATERAL=
# BINARY_MODULE=

# Book granularity, raw units. Binary market rows carry no tickSize/lotSize, so
# these are not discoverable and come from config.
# MM_TICK=
# MM_LOT=

# DreamDEX REST auth, if required.
# DREAMDEX_API_KEY=

# ---- Privy (wallet connection) ----------------------------------------------
# The PUBLIC app id. It ships in the browser bundle by design; that is fine.
VITE_PRIVY_APP_ID=
#
# The Privy APP SECRET does not belong here, or anywhere in this repo. It is a
# server credential and this product has no server (§12) — anything holding it
# can act as your app. If one has ever been pasted into a shell, a commit, a
# chat or a log, rotate it in the Privy dashboard and move on.

# Routing fee on BOOK orders only — never on a room or a duel.
#
# Off unless BOTH are set. The venue itself takes nothing from either side, so
# anything charged here is yours and should be a decision, not a default.
#
# The unit is bps x 1000, which is easy to be out by a factor of ten on:
#
#   1_000   =  1 bps  = 0.01%     a rounding error on a 1 tUSDC trade
#   10_000  = 10 bps  = 0.1%
#   100_000 = 100 bps = 1%        the top of what most venues allow
#
# The pool refuses anything above the venue's own frozen ceiling, and above
# whatever the trader approved.
BUILDER_ADDRESS=
BUILDER_FEE_BPS_TIMES_1K=0

# Vite only exposes VITE_-prefixed vars to the browser.
VITE_BUILDER_ADDRESS=
VITE_BUILDER_FEE_BPS_TIMES_1K=0
