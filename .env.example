# ---- BULLRUN ----------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
#
# SWITCHING NETWORK IS THIS ONE LINE. Chain id, RPC, indexer, collateral,
# decimals, tick/lot and venue all follow from it (packages/sdk/src/networks.ts).
#
#   testnet -> chain 50312, tUSDC, 6 decimals, has a faucet
#   mainnet -> chain 5031,  USDso, 18 decimals, real money
NETWORK=testnet

# The web app reads VITE_-prefixed names. Keep the two in step.
VITE_NETWORK=testnet

# ---- Escrow, per network ----------------------------------------------------
# Each network needs its own deploy. Both can live here at once; the active
# NETWORK picks which one is used, so switching never points at the wrong one.
DUEL_ESCROW_ADDRESS_TESTNET=
DUEL_ESCROW_ADDRESS_MAINNET=
VITE_DUEL_ESCROW_ADDRESS_TESTNET=
VITE_DUEL_ESCROW_ADDRESS_MAINNET=

# ---- Signers (packages/scripts only) ----------------------------------------
# Two DIFFERENT wallets — accept() reverts SelfDuel if they match.
# On mainnet these hold real funds. Treat accordingly.
PRIVATE_KEY_A=
PRIVATE_KEY_B=

# ---- Optional overrides -----------------------------------------------------
# Everything below defaults from the deployment map. Set one only when a
# redeploy lands before networks.ts is updated.

# RPC_URL=
# WS_RPC_URL=
# INDEXER_URL=
# REST_URL=
# EXPLORER_URL=
# CHAIN_ID=
# DECIMALS=

# Venue scope. THESE MOVE — both networks changed venue three times in the first
# week of August 2026. If reads return no markets, take venueId off a live row.
# VENUE_ID=

# Individual contract overrides.
# COLLATERAL=
# BINARY_MODULE=

# Book granularity, raw units. Binary market rows carry no tickSize/lotSize, so
# these are not discoverable and come from config.
# MM_TICK=
# MM_LOT=

# DreamDEX REST auth, if required.
# DREAMDEX_API_KEY=
