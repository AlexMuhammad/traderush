{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @traderush/sdk build && pnpm --filter @traderush/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
